# URL final do seu domínio (ex: https://calculafiscal.com.br)
NEXT_PUBLIC_SITE_URL=https://calculafiscal.com.br

# Seu ID de Editor do Google AdSense (preencher quando criar a conta AdSense)
# Formato: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Código de Verificação do Google Search Console (opcional, apenas o código alfanumérico)
NEXT_PUBLIC_GSC_VERIFICATION=

# ID de Métrica do Google Analytics 4 (opcional, ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
